# Contact & support form email (Nodemailer via Gmail / Google Workspace SMTP).
# Create an app password at https://myaccount.google.com/apppasswords (requires 2-Step Verification).
# If GOOGLE_EMAIL is empty, messages are logged to the server console instead of being sent.
GOOGLE_EMAIL=
GOOGLE_EMAIL_PASSWORD=
# Optional. Defaults: smtp.gmail.com and 465 (use 587 for STARTTLS).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
# Optional. Where messages are delivered. Defaults to info@lovefirstchristiancenter.com
CONTACT_TO=
